using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using SafeSeated.Application.Dtos.Auth;
using SafeSeated.Application.Services;
using System.Security.Claims;

namespace SafeSeated.Api.Controllers;

/// <summary>
/// Authentication controller for register, login, refresh token, and password management
/// </summary>
[ApiController]
[Route("api/v1/auth")]
public class AuthController : ControllerBase
{
    private readonly IAuthService _authService;
    private readonly ILogger<AuthController> _logger;

    public AuthController(IAuthService authService, ILogger<AuthController> logger)
    {
        _authService = authService;
        _logger = logger;
    }

    /// <summary>
    /// Register a new passenger
    /// </summary>
    /// <param name="request">Passenger registration request</param>
    /// <returns>Registration result with user ID</returns>
    [HttpPost("register/passenger")]
    [AllowAnonymous]
    [ProducesResponseType(StatusCodes.Status201Created)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<IActionResult> RegisterPassenger([FromBody] RegisterPassengerRequestDto request)
    {
        if (!ModelState.IsValid)
            return BadRequest(ModelState);

        _logger.LogInformation($"Passenger registration attempt for email: {request.Email}");

        var (success, message, userId) = await _authService.RegisterPassengerAsync(request);

        if (!success)
            return BadRequest(new { message });

        return CreatedAtAction(null, new
        {
            message,
            userId,
            status = "pending_approval"
        });
    }

    /// <summary>
    /// Register a new driver
    /// </summary>
    /// <param name="request">Driver registration request</param>
    /// <returns>Registration result with user ID</returns>
    [HttpPost("register/driver")]
    [AllowAnonymous]
    [ProducesResponseType(StatusCodes.Status201Created)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<IActionResult> RegisterDriver([FromBody] RegisterDriverRequestDto request)
    {
        if (!ModelState.IsValid)
            return BadRequest(ModelState);

        _logger.LogInformation($"Driver registration attempt for email: {request.Email}");

        var (success, message, userId) = await _authService.RegisterDriverAsync(request);

        if (!success)
            return BadRequest(new { message });

        return CreatedAtAction(null, new
        {
            message,
            userId,
            status = "pending_approval"
        });
    }

    /// <summary>
    /// User login - returns JWT access token and refresh token
    /// </summary>
    /// <param name="request">Login credentials</param>
    /// <returns>JWT tokens and user info</returns>
    [HttpPost("login")]
    [AllowAnonymous]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status401Unauthorized)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<IActionResult> Login([FromBody] LoginRequestDto request)
    {
        if (!ModelState.IsValid)
            return BadRequest(ModelState);

        _logger.LogInformation($"Login attempt for email: {request.Email}");

        var (success, tokens, message) = await _authService.LoginAsync(request);

        if (!success)
        {
            _logger.LogWarning($"Failed login attempt for email: {request.Email}. Reason: {message}");
            return Unauthorized(new { message });
        }

        return Ok(tokens);
    }

    /// <summary>
    /// Refresh JWT access token using refresh token
    /// </summary>
    /// <param name="request">Refresh token request</param>
    /// <returns>New JWT tokens</returns>
    [HttpPost("refresh")]
    [AllowAnonymous]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status401Unauthorized)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<IActionResult> RefreshToken([FromBody] RefreshTokenRequestDto request)
    {
        if (!ModelState.IsValid)
            return BadRequest(ModelState);

        var (success, tokens, message) = await _authService.RefreshTokenAsync(request);

        if (!success)
            return Unauthorized(new { message });

        return Ok(tokens);
    }

    /// <summary>
    /// Change user password
    /// </summary>
    /// <param name="request">Password change request</param>
    /// <returns>Success or failure message</returns>
    [HttpPost("change-password")]
    [Authorize]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [ProducesResponseType(StatusCodes.Status401Unauthorized)]
    public async Task<IActionResult> ChangePassword([FromBody] ChangePasswordRequestDto request)
    {
        if (!ModelState.IsValid)
            return BadRequest(ModelState);

        var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userIdClaim, out var userId))
            return Unauthorized(new { message = "Invalid token" });

        _logger.LogInformation($"Password change attempt for user: {userId}");

        var (success, message) = await _authService.ChangePasswordAsync(userId, request);

        if (!success)
            return BadRequest(new { message });

        return Ok(new { message });
    }

    /// <summary>
    /// Get registration status for a user
    /// </summary>
    /// <returns>Registration status (Pending, Approved, or Rejected)</returns>
    [HttpGet("registration-status")]
    [Authorize]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status401Unauthorized)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> GetRegistrationStatus()
    {
        var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userIdClaim, out var userId))
            return Unauthorized(new { message = "Invalid token" });

        var status = await _authService.GetRegistrationStatusAsync(userId);

        if (status == null)
            return NotFound(new { message = "User not found" });

        return Ok(status);
    }

    /// <summary>
    /// Logout from all devices (revoke all refresh tokens)
    /// </summary>
    /// <returns>Success message</returns>
    [HttpPost("logout-all-devices")]
    [Authorize]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status401Unauthorized)]
    public async Task<IActionResult> LogoutAllDevices()
    {
        var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userIdClaim, out var userId))
            return Unauthorized(new { message = "Invalid token" });

        _logger.LogInformation($"Logout all devices for user: {userId}");

        var success = await _authService.LogoutAllDevicesAsync(userId, "User initiated logout");

        if (!success)
            return BadRequest(new { message = "Failed to logout" });

        return Ok(new { message = "Successfully logged out from all devices" });
    }

    /// <summary>
    /// Logout from current device
    /// </summary>
    /// <param name="request">Current refresh token</param>
    /// <returns>Success message</returns>
    [HttpPost("logout")]
    [Authorize]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status401Unauthorized)]
    public async Task<IActionResult> Logout([FromBody] RefreshTokenRequestDto request)
    {
        var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userIdClaim, out var userId))
            return Unauthorized(new { message = "Invalid token" });

        _logger.LogInformation($"Logout for user: {userId}");

        // Optional: Could also revoke just this specific token
        // For now, we'll treat single logout as device logout
        var success = await _authService.LogoutAllDevicesAsync(userId, "User initiated logout");

        if (!success)
            return BadRequest(new { message = "Failed to logout" });

        return Ok(new { message = "Successfully logged out" });
    }
}

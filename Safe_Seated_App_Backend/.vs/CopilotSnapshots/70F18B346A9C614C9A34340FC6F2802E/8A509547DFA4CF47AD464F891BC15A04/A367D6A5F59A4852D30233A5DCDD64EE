using Microsoft.EntityFrameworkCore;
using Microsoft.IdentityModel.Tokens;
using SafeSeated.Application.Dtos.Auth;
using SafeSeated.Application.Services;
using SafeSeated.Domain.Entities;
using SafeSeated.Domain.Enums;
using SafeSeated.Infrastructure.Data;
using SafeSeated.Infrastructure.Utilities;
using System.IdentityModel.Tokens.Jwt;
using System.Security.Cryptography;
using System.Text;

namespace SafeSeated.Infrastructure.Services;

/// <summary>
/// Authentication service implementation
/// </summary>
public class AuthService : IAuthService
{
    private readonly SafeSeatedDbContext _context;
    private readonly IConfiguration _configuration;
    private readonly ILogger<AuthService> _logger;

    public AuthService(SafeSeatedDbContext context, IConfiguration configuration, ILogger<AuthService> logger)
    {
        _context = context;
        _configuration = configuration;
        _logger = logger;
    }

    /// <inheritdoc />
    public async Task<(bool success, string message, Guid? userId)> RegisterPassengerAsync(RegisterPassengerRequestDto request)
    {
        try
        {
            // Validate input
            if (!ValidationUtilities.IsValidPhoneNumber(request.Phone))
                return (false, "Invalid phone number format. Use 03XX-XXXXXXX", null);

            if (!ValidationUtilities.IsValidCnic(request.Cnic))
                return (false, "Invalid CNIC format. Use XXXXX-XXXXXXX-X", null);

            var (isValidPassword, passwordErrors) = ValidationUtilities.ValidatePassword(request.Password);
            if (!isValidPassword)
                return (false, $"Password requirements not met: {string.Join(", ", passwordErrors)}", null);

            if (!ValidationUtilities.IsValidFullName(request.FullName))
                return (false, "Full name must contain at least first and last name", null);

            // Check if user already exists
            var existingUser = await _context.Users.FirstOrDefaultAsync(u =>
                u.Email == request.Email.ToLower() || u.Phone == request.Phone || u.Cnic == request.Cnic);

            if (existingUser != null)
                return (false, "User with this email, phone, or CNIC already exists", null);

            // Create new passenger user
            var user = new User
            {
                Id = Guid.NewGuid(),
                FullName = request.FullName.Trim(),
                Email = request.Email.ToLower(),
                Phone = request.Phone,
                Cnic = request.Cnic,
                PasswordHash = HashPassword(request.Password),
                Role = UserRole.Passenger,
                Status = UserStatus.Pending, // Awaiting admin approval
                CreatedAt = DateTime.UtcNow
            };

            // Create passenger profile
            var passengerProfile = new PassengerProfile
            {
                Id = Guid.NewGuid(),
                UserId = user.Id,
                CreatedAt = DateTime.UtcNow
            };

            _context.Users.Add(user);
            _context.PassengerProfiles.Add(passengerProfile);
            await _context.SaveChangesAsync();

            _logger.LogInformation($"Passenger registered: {user.Email}");
            return (true, "Passenger registered successfully. Awaiting admin approval.", user.Id);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error registering passenger");
            return (false, "An error occurred during registration", null);
        }
    }

    /// <inheritdoc />
    public async Task<(bool success, string message, Guid? userId)> RegisterDriverAsync(RegisterDriverRequestDto request)
    {
        try
        {
            // Validate input
            if (!ValidationUtilities.IsValidPhoneNumber(request.Phone))
                return (false, "Invalid phone number format. Use 03XX-XXXXXXX", null);

            if (!ValidationUtilities.IsValidCnic(request.Cnic))
                return (false, "Invalid CNIC format. Use XXXXX-XXXXXXX-X", null);

            var (isValidPassword, passwordErrors) = ValidationUtilities.ValidatePassword(request.Password);
            if (!isValidPassword)
                return (false, $"Password requirements not met: {string.Join(", ", passwordErrors)}", null);

            if (!ValidationUtilities.IsValidFullName(request.FullName))
                return (false, "Full name must contain at least first and last name", null);

            if (request.SeatCapacity < 1 || request.SeatCapacity > 8)
                return (false, "Seat capacity must be between 1 and 8", null);

            // Check if user already exists
            var existingUser = await _context.Users.FirstOrDefaultAsync(u =>
                u.Email == request.Email.ToLower() || u.Phone == request.Phone || u.Cnic == request.Cnic);

            if (existingUser != null)
                return (false, "User with this email, phone, or CNIC already exists", null);

            // Create new driver user
            var user = new User
            {
                Id = Guid.NewGuid(),
                FullName = request.FullName.Trim(),
                Email = request.Email.ToLower(),
                Phone = request.Phone,
                Cnic = request.Cnic,
                PasswordHash = HashPassword(request.Password),
                Role = UserRole.Driver,
                Status = UserStatus.Pending, // Awaiting admin approval and document verification
                CreatedAt = DateTime.UtcNow
            };

            // Create driver profile
            var driverProfile = new DriverProfile
            {
                Id = Guid.NewGuid(),
                UserId = user.Id,
                VehicleRegistration = request.VehicleRegistration.ToUpper(),
                VehicleModel = request.VehicleModel.Trim(),
                VehicleColor = request.VehicleColor.Trim(),
                SeatCapacity = request.SeatCapacity,
                IsVerified = false,
                Rating = 5.0m, // Default rating
                TotalRides = 0,
                CreatedAt = DateTime.UtcNow
            };

            _context.Users.Add(user);
            _context.DriverProfiles.Add(driverProfile);
            await _context.SaveChangesAsync();

            _logger.LogInformation($"Driver registered: {user.Email}");
            return (true, "Driver registered successfully. Awaiting admin approval and document verification.", user.Id);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error registering driver");
            return (false, "An error occurred during registration", null);
        }
    }

    /// <inheritdoc />
    public async Task<(bool success, TokenResponseDto? tokens, string message)> LoginAsync(LoginRequestDto request)
    {
        try
        {
            // Find user by email
            var user = await _context.Users
                .Include(u => u.PassengerProfile)
                .Include(u => u.DriverProfile)
                .FirstOrDefaultAsync(u => u.Email == request.Email.ToLower());

            if (user == null)
                return (false, null, "Invalid email or password");

            // Verify password
            if (!VerifyPassword(request.Password, user.PasswordHash))
                return (false, null, "Invalid email or password");

            // Check user status
            if (user.Status != UserStatus.Approved)
                return (false, null, $"User account is {user.Status}. Please wait for admin approval.");

            // Generate tokens
            var accessToken = GenerateJwtToken(user);
            var refreshTokenHash = GenerateRefreshToken(out var refreshTokenPlain);

            // Save refresh token to database
            var refreshToken = new RefreshToken
            {
                Id = Guid.NewGuid(),
                UserId = user.Id,
                TokenHash = refreshTokenHash,
                ExpiresAt = DateTime.UtcNow.AddDays(int.Parse(_configuration["Jwt:RefreshTokenExpiryDays"] ?? "7")),
                DeviceInfo = request.DeviceInfo,
                IpAddress = request.IpAddress,
                CreatedAt = DateTime.UtcNow
            };

            _context.RefreshTokens.Add(refreshToken);
            user.LastLoginAt = DateTime.UtcNow;
            await _context.SaveChangesAsync();

            var response = new TokenResponseDto
            {
                AccessToken = accessToken,
                RefreshToken = refreshTokenPlain,
                ExpiresIn = int.Parse(_configuration["Jwt:AccessTokenExpiryMinutes"] ?? "15") * 60,
                User = new UserTokenDto
                {
                    Id = user.Id,
                    FullName = user.FullName,
                    Email = user.Email,
                    Phone = user.Phone,
                    Role = user.Role.ToString(),
                    Status = user.Status.ToString()
                }
            };

            _logger.LogInformation($"User logged in: {user.Email}");
            return (true, response, "Login successful");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error during login");
            return (false, null, "An error occurred during login");
        }
    }

    /// <inheritdoc />
    public async Task<(bool success, TokenResponseDto? tokens, string message)> RefreshTokenAsync(RefreshTokenRequestDto request)
    {
        try
        {
            // Hash the provided refresh token
            var providedTokenHash = HashToken(request.RefreshToken);

            // Find the refresh token in database
            var refreshToken = await _context.RefreshTokens
                .Include(rt => rt.User)
                .FirstOrDefaultAsync(rt => rt.TokenHash == providedTokenHash);

            if (refreshToken == null)
                return (false, null, "Invalid refresh token");

            if (refreshToken.IsExpired)
                return (false, null, "Refresh token has expired");

            if (refreshToken.IsRevoked)
                return (false, null, "Refresh token has been revoked");

            var user = refreshToken.User;
            if (user == null)
                return (false, null, "User not found");

            if (user.Status != UserStatus.Approved)
                return (false, null, "User account is not approved");

            // Generate new tokens
            var accessToken = GenerateJwtToken(user);
            var newRefreshTokenHash = GenerateRefreshToken(out var newRefreshTokenPlain);

            // Revoke old token and create new one
            refreshToken.RevokedAt = DateTime.UtcNow;
            refreshToken.RevokedReason = "Token refreshed";

            var newRefreshToken = new RefreshToken
            {
                Id = Guid.NewGuid(),
                UserId = user.Id,
                TokenHash = newRefreshTokenHash,
                ExpiresAt = DateTime.UtcNow.AddDays(int.Parse(_configuration["Jwt:RefreshTokenExpiryDays"] ?? "7")),
                DeviceInfo = request.DeviceInfo,
                IpAddress = request.IpAddress,
                CreatedAt = DateTime.UtcNow
            };

            _context.RefreshTokens.Add(newRefreshToken);
            await _context.SaveChangesAsync();

            var response = new TokenResponseDto
            {
                AccessToken = accessToken,
                RefreshToken = newRefreshTokenPlain,
                ExpiresIn = int.Parse(_configuration["Jwt:AccessTokenExpiryMinutes"] ?? "15") * 60,
                User = new UserTokenDto
                {
                    Id = user.Id,
                    FullName = user.FullName,
                    Email = user.Email,
                    Phone = user.Phone,
                    Role = user.Role.ToString(),
                    Status = user.Status.ToString()
                }
            };

            _logger.LogInformation($"Token refreshed for user: {user.Email}");
            return (true, response, "Token refreshed successfully");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error refreshing token");
            return (false, null, "An error occurred while refreshing token");
        }
    }

    /// <inheritdoc />
    public async Task<(bool success, string message)> ChangePasswordAsync(Guid userId, ChangePasswordRequestDto request)
    {
        try
        {
            var user = await _context.Users.FindAsync(userId);
            if (user == null)
                return (false, "User not found");

            // Verify current password
            if (!VerifyPassword(request.CurrentPassword, user.PasswordHash))
                return (false, "Current password is incorrect");

            // Validate new password
            var (isValid, errors) = ValidationUtilities.ValidatePassword(request.NewPassword);
            if (!isValid)
                return (false, $"New password requirements not met: {string.Join(", ", errors)}");

            // Update password
            user.PasswordHash = HashPassword(request.NewPassword);
            await _context.SaveChangesAsync();

            // Revoke all existing refresh tokens (force re-login on all devices)
            var existingTokens = await _context.RefreshTokens
                .Where(rt => rt.UserId == userId && rt.RevokedAt == null)
                .ToListAsync();

            foreach (var token in existingTokens)
            {
                token.RevokedAt = DateTime.UtcNow;
                token.RevokedReason = "Password changed";
            }

            await _context.SaveChangesAsync();

            _logger.LogInformation($"Password changed for user: {user.Email}");
            return (true, "Password changed successfully. Please log in again.");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error changing password");
            return (false, "An error occurred while changing password");
        }
    }

    /// <inheritdoc />
    public async Task<(bool valid, string? message, Guid? userId)> ValidateCredentialsAsync(string email, string password)
    {
        try
        {
            var user = await _context.Users.FirstOrDefaultAsync(u => u.Email == email.ToLower());
            if (user == null)
                return (false, "Invalid credentials", null);

            if (!VerifyPassword(password, user.PasswordHash))
                return (false, "Invalid credentials", null);

            if (user.Status != UserStatus.Approved)
                return (false, $"User account is {user.Status}", null);

            return (true, null, user.Id);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error validating credentials");
            return (false, "An error occurred", null);
        }
    }

    /// <inheritdoc />
    public async Task<RegistrationStatusDto?> GetRegistrationStatusAsync(Guid userId)
    {
        try
        {
            var user = await _context.Users.FindAsync(userId);
            if (user == null)
                return null;

            return new RegistrationStatusDto
            {
                UserId = user.Id,
                Status = user.Status.ToString(),
                RejectionReason = user.RejectionReason
            };
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting registration status");
            return null;
        }
    }

    /// <inheritdoc />
    public async Task<bool> LogoutAllDevicesAsync(Guid userId, string? reason = null)
    {
        try
        {
            var tokens = await _context.RefreshTokens
                .Where(rt => rt.UserId == userId && rt.RevokedAt == null)
                .ToListAsync();

            foreach (var token in tokens)
            {
                token.RevokedAt = DateTime.UtcNow;
                token.RevokedReason = reason ?? "Logged out";
            }

            await _context.SaveChangesAsync();
            _logger.LogInformation($"All devices logged out for user: {userId}");
            return true;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error logging out all devices");
            return false;
        }
    }

    /// <inheritdoc />
    public async Task<bool> RevokeRefreshTokenAsync(string tokenHash, string? reason = null)
    {
        try
        {
            var token = await _context.RefreshTokens
                .FirstOrDefaultAsync(rt => rt.TokenHash == tokenHash && rt.RevokedAt == null);

            if (token == null)
                return false;

            token.RevokedAt = DateTime.UtcNow;
            token.RevokedReason = reason ?? "Revoked";
            await _context.SaveChangesAsync();
            return true;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error revoking refresh token");
            return false;
        }
    }

    // Helper methods

    private string GenerateJwtToken(User user)
    {
        var secretKey = _configuration["Jwt:SecretKey"]
            ?? throw new InvalidOperationException("JWT SecretKey not configured");
        var issuer = _configuration["Jwt:Issuer"]
            ?? throw new InvalidOperationException("JWT Issuer not configured");
        var audience = _configuration["Jwt:Audience"]
            ?? throw new InvalidOperationException("JWT Audience not configured");
        var expiryMinutes = int.Parse(_configuration["Jwt:AccessTokenExpiryMinutes"] ?? "15");

        var key = new SymmetricSecurityKey(Encoding.UTF8.GetBytes(secretKey));
        var credentials = new SigningCredentials(key, SecurityAlgorithms.HmacSha256);

        var claims = new[]
        {
            new System.Security.Claims.Claim(System.Security.Claims.ClaimTypes.NameIdentifier, user.Id.ToString()),
            new System.Security.Claims.Claim(System.Security.Claims.ClaimTypes.Email, user.Email),
            new System.Security.Claims.Claim(System.Security.Claims.ClaimTypes.Name, user.FullName),
            new System.Security.Claims.Claim(System.Security.Claims.ClaimTypes.Role, user.Role.ToString())
        };

        var token = new JwtSecurityToken(
            issuer: issuer,
            audience: audience,
            claims: claims,
            expires: DateTime.UtcNow.AddMinutes(expiryMinutes),
            signingCredentials: credentials);

        return new JwtSecurityTokenHandler().WriteToken(token);
    }

    private string GenerateRefreshToken(out string plainToken)
    {
        var randomNumber = new byte[32];
        using (var rng = RandomNumberGenerator.Create())
        {
            rng.GetBytes(randomNumber);
            plainToken = Convert.ToBase64String(randomNumber);
        }
        return HashToken(plainToken);
    }

    private string HashToken(string token)
    {
        using (var sha256 = System.Security.Cryptography.SHA256.Create())
        {
            var hashedBytes = sha256.ComputeHash(Encoding.UTF8.GetBytes(token));
            return Convert.ToBase64String(hashedBytes);
        }
    }

    private string HashPassword(string password)
    {
        return BCrypt.Net.BCrypt.HashPassword(password, workFactor: 12);
    }

    private bool VerifyPassword(string password, string hash)
    {
        return BCrypt.Net.BCrypt.Verify(password, hash);
    }
}

using System.Text.RegularExpressions;

namespace SafeSeated.Infrastructure.Utilities;

/// <summary>
/// Validation utilities for user registration and authentication
/// </summary>
public static class ValidationUtilities
{
    // Pakistan phone format: 03XX-XXXXXXX (e.g., 03001234567 or 0300-1234567)
    private static readonly Regex PhoneRegex = new(@"^03\d{2}-\d{7}$", RegexOptions.Compiled);

    // Pakistan CNIC format: XXXXX-XXXXXXX-X (e.g., 35202-1234567-1)
    private static readonly Regex CnicRegex = new(@"^\d{5}-\d{7}-\d$", RegexOptions.Compiled);

    // Email validation (basic)
    private static readonly Regex EmailRegex = new(@"^[^\s@]+@[^\s@]+\.[^\s@]+$", RegexOptions.Compiled);

    /// <summary>
    /// Validates Pakistan phone number format
    /// </summary>
    public static bool IsValidPhoneNumber(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return false;

        return PhoneRegex.IsMatch(phone);
    }

    /// <summary>
    /// Validates Pakistan CNIC format
    /// </summary>
    public static bool IsValidCnic(string cnic)
    {
        if (string.IsNullOrWhiteSpace(cnic))
            return false;

        return CnicRegex.IsMatch(cnic);
    }

    /// <summary>
    /// Validates email format
    /// </summary>
    public static bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return false;

        return EmailRegex.IsMatch(email);
    }

    /// <summary>
    /// Validates password strength
    /// Requirements: min 8 chars, at least 1 uppercase, 1 lowercase, 1 digit
    /// </summary>
    public static (bool isValid, List<string> errors) ValidatePassword(string password)
    {
        var errors = new List<string>();

        if (string.IsNullOrWhiteSpace(password))
        {
            errors.Add("Password is required");
            return (false, errors);
        }

        if (password.Length < 8)
            errors.Add("Password must be at least 8 characters");

        if (!password.Any(char.IsUpper))
            errors.Add("Password must contain at least one uppercase letter");

        if (!password.Any(char.IsLower))
            errors.Add("Password must contain at least one lowercase letter");

        if (!password.Any(char.IsDigit))
            errors.Add("Password must contain at least one digit");

        return (errors.Count == 0, errors);
    }

    /// <summary>
    /// Normalizes phone number (removes spaces, converts to standard format if needed)
    /// </summary>
    public static string NormalizePhoneNumber(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return string.Empty;

        // Remove spaces and dashes
        var cleaned = phone.Replace(" ", "").Replace("-", "");

        // If starts with 0, format as 03XX-XXXXXXX
        if (cleaned.StartsWith("0") && cleaned.Length == 11)
        {
            return $"{cleaned.Substring(0, 4)}-{cleaned.Substring(4)}";
        }

        // If starts with 3, add 0 prefix
        if (cleaned.StartsWith("3") && cleaned.Length == 10)
        {
            cleaned = "0" + cleaned;
            return $"{cleaned.Substring(0, 4)}-{cleaned.Substring(4)}";
        }

        return phone; // Return as-is if format unclear
    }

    /// <summary>
    /// Normalizes CNIC (removes spaces)
    /// </summary>
    public static string NormalizeCnic(string cnic)
    {
        if (string.IsNullOrWhiteSpace(cnic))
            return string.Empty;

        // Remove extra spaces, keep standard format
        return Regex.Replace(cnic.Trim(), @"\s+", "");
    }

    /// <summary>
    /// Validates full name (at least 2 parts, alphanumeric + spaces)
    /// </summary>
    public static bool IsValidFullName(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return false;

        var parts = fullName.Trim().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length < 2)
            return false;

        // Check each part contains only letters, numbers, and hyphens/apostrophes
        return parts.All(part => 
            Regex.IsMatch(part, @"^[a-zA-Z0-9\-']+$"));
    }
}

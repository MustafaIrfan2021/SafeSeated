        var now = DateTime.UtcNow;

        // Create sample rides
        var ride1 = new Ride
        {
            DriverId = driverSana.Id,
            PickupArea = "Gulshan-e-Iqbal",
            Destination = "SMIU, Shahrah-e-Faisal",
            DepartureTime = now.AddHours(2),

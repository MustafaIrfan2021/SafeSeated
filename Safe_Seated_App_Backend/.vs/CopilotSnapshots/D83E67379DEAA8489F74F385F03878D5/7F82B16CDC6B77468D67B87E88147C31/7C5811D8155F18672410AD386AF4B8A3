            PricePerSeat = 200,
            SeatsOffered = 3,
            Status = RideStatus.Active,
            CreatedAt = now.AddHours(-1)
        };

        context.Rides.AddRange(ride1, ride2);
        await context.SaveChangesAsync();

        // Create sample bookings
        var booking1 = new Booking
        {
            RideId = ride1.Id,

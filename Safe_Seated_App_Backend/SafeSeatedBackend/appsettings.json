{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SafeSeatedDb;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Admin": {
    "Email": "admin@safeseated.pk",
    "Password": ""
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "SafeSeated",
    "Audience": "SafeSeatedClient",
    "AccessTokenExpiryMinutes": 15
  },
  "ServiceFee": {
    "PercentageOfEarnings": 20.0
  },
  "Pagination": {
    "DefaultPageSize": 10,
    "MaxPageSize": 100
  },
  "RateLimiting": {
    "AuthEndpointLimit": 5,
    "AuthEndpointWindowSeconds": 900
  },
  "FormatSettings": {
    "PakistaniPhoneRegex": "^03\\d{9}$",
    "PakistaniCnicRegex": "^\\d{13}$"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*"
}
